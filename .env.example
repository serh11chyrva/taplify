# Copy to .env.local. External services are only required when used.
MONGODB_URI=mongodb://127.0.0.1:27017/taplify
MONGODB_DB_NAME=taplify

# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional credentials for Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Enable each dashboard release after applying its database indexes.
DASHBOARD_ENABLED=false
PAGE_FORMS_ENABLED=false
PAGE_ANALYTICS_ENABLED=false
# Generate independently from BETTER_AUTH_SECRET.
PAGE_ANALYTICS_SECRET=
ORGANIZATION_INVITATIONS_ENABLED=false
# Resend credentials and the verified sender used for invitations and email verification.
RESEND_API_KEY=
TAPLIFY_MAIL_FROM=
# The canonical origin for public page links on this deployment.
PUBLIC_SITE_ORIGIN=http://localhost:3000

# Optional GA4 web stream measurement ID (G-...). Set before building.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# Use a private Vercel Blob store for page images.
BLOB_READ_WRITE_TOKEN=
