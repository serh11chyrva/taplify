# Copy to .env.local. External services are only required when used.
MONGODB_URI=mongodb://127.0.0.1:27017/taplify
MONGODB_DB_NAME=taplify

# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional GA4 web stream measurement ID (G-...). Set before building.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# Use a public Vercel Blob store for page images.
BLOB_READ_WRITE_TOKEN=
